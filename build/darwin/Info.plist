<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for Lathe.app. build/darwin/package.sh fills in the
  placeholders and checks the result with `plutil -lint`:
    @SHORT_VERSION@  numeric X.Y.Z (prerelease/snapshot suffix stripped; Apple
                     wants at most three dot-separated integers here)
    @VERSION@        the full release version, e.g. 1.2.0-rc.1

  LSMinimumSystemVersion is 12.0 (Monterey): Go 1.25+ binaries do not run on
  anything older, so Wails v3's 10.15 template default would be a lie. Keep it
  in sync with MIN_MACOS in package.sh (the cgo deployment target) and with
  `depends_on macos:` in build/homebrew/cask.sh.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleName</key>
	<string>Lathe</string>
	<key>CFBundleDisplayName</key>
	<string>Lathe</string>
	<key>CFBundleExecutable</key>
	<string>lathe</string>
	<key>CFBundleIdentifier</key>
	<string>com.devenjarvis.lathe</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleGetInfoString</key>
	<string>Lathe @VERSION@</string>
	<key>CFBundleIconFile</key>
	<string>icons</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright (c) 2026 Deven Jarvis. MIT License.</string>
</dict>
</plist>
